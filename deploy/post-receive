#!/usr/bin/env bash
set -euo pipefail

export PATH="/root/.bun/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

APP_DIR="/var/www/timetable-website"
BARE_REPO="/root/repos/timetable-website.git"
BRANCH="main"

echo "Deploying Timetable website..."

git --work-tree="$APP_DIR" --git-dir="$BARE_REPO" checkout -f "$BRANCH"

cd "$APP_DIR"

unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
unset GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "Installing dependencies..."
bun install --frozen-lockfile

echo "Building production application..."
bun run build

echo "Restarting PM2..."
pm2 startOrRestart ecosystem.config.cjs --env production

echo "Saving PM2 process list..."
pm2 save

echo "Deployment complete."
