server {
	listen 80;
	listen [::]:80;

	server_name timetable.adonis.pt;

	return 301 https://$host$request_uri;
}

server {
	listen 127.0.0.1:4433 ssl;

	server_name timetable.adonis.pt;

	ssl_certificate /etc/letsencrypt/live/timetable.adonis.pt/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/timetable.adonis.pt/privkey.pem;
	include /etc/letsencrypt/options-ssl-nginx.conf;
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

	client_max_body_size 5m;
	add_header Strict-Transport-Security "max-age=31536000" always;
	add_header Cross-Origin-Opener-Policy "same-origin" always;
	add_header X-Frame-Options "DENY" always;
	add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" always;

	gzip on;
	gzip_comp_level 6;
	gzip_min_length 1024;
	gzip_vary on;
	gzip_types
		application/javascript
		application/json
		application/manifest+json
		application/xml
		image/svg+xml
		text/css
		text/javascript
		text/plain
		text/xml;

	location = /.well-known/apple-app-site-association {
		proxy_pass http://127.0.0.1:8081;

		include /etc/nginx/proxy_params;
		proxy_set_header X-Request-ID $http_x_request_id;
	}

	location ^~ /api/ {
		proxy_pass http://127.0.0.1:8081;

		include /etc/nginx/proxy_params;
		proxy_set_header X-Request-ID $http_x_request_id;

		proxy_request_buffering on;
		proxy_buffering on;

		proxy_connect_timeout 10s;
		proxy_send_timeout 60s;
		proxy_read_timeout 60s;
	}

	location / {
		proxy_pass http://127.0.0.1:3000;

		include /etc/nginx/proxy_params;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
	}
}
